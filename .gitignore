# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
/test-results/
/playwright-report/

# workflow devkit
.workflow-data/
.well-known/workflow/

# remotion
.remotion/
/out/

# local design mocks (never committed)
/designs/
/.swc
.env*.local

# drizzle-kit output
/drizzle/
/.taste-skill/

# design mocks served by next dev, not shipped
/public/mocks/
